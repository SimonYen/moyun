# 项目不会读取 .env 文件，这里只是变量名清单。
# 用法：先 export 变量再启动，例如
#   export DJANGO_SECRET_KEY="$(python -c 'import secrets;print(secrets.token_urlsafe(50))')"
#   sh start.sh
# 或在 PaaS 控制台配置同名环境变量；start.sh 优先读环境变量，未设置则用默认值。

# 必填：生成命令 python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# 必填：首次初始化 admin 的密码
# BLOG_ADMIN_PASSWORD=

# 可选：限制可访问域名（生产环境务必设置）
# DJANGO_ALLOWED_HOSTS=your-domain.example

# 可选：CSRF 信任的来源（反代改写 Host 时必须配）
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# 可选：跳过相册演示数据
# SKIP_DEMO_DATA=1

# 可选：传输模式，1 = WebSocket（默认），0 = 回退 SSE
# 只在部署平台不转发 WebSocket upgrade 时才需要设 0
# BLOG_USE_WEBSOCKET=0
